# Copy to .env (it is git-ignored) and fill in. Secrets never go into the repository.

# --- hh.ru (https://dev.hh.ru) ---
# Required for API requests. Format: AppName/version (contact email)
HH_USER_AGENT=hh-parser/0.1 (your-email@example.com)
# Application token from dev.hh.ru. It is the only credential the project uses.
HH_APP_TOKEN=
